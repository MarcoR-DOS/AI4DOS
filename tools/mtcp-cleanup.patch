diff --git a/src/TCPLIB/PACKET.CPP b/src/TCPLIB/PACKET.CPP
--- a/src/TCPLIB/PACKET.CPP
+++ b/src/TCPLIB/PACKET.CPP
@@ -149,6 +149,7 @@ int8_t Buffer_init( void ) {
   if ( tmp == NULL ) {
     return -1;
   }
+  BufferMemPtr = tmp;
 
   // Put pointers to packets in the free stack.
 
@@ -262,7 +263,12 @@ void Buffer_stopReceiving( void ) { Buffer_fs_index = 0; }
 // This is about the last step before shutting everything down.  It just has
 // to return the memory that was allocated.
 
-void Buffer_stop( void ) { if ( BufferMemPtr) free( BufferMemPtr ); }
+void Buffer_stop( void ) {
+  if ( BufferMemPtr ) {
+    free( BufferMemPtr );
+    BufferMemPtr = NULL;
+  }
+}
 
 
 
