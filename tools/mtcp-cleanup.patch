diff --git a/src/TCPLIB/UTILS.CPP b/src/TCPLIB/UTILS.CPP
--- a/src/TCPLIB/UTILS.CPP
+++ b/src/TCPLIB/UTILS.CPP
@@ -1053,7 +1053,14 @@ void Utils::endStack2( bool ignoreTracing ) {
   #endif
 
 
+  #if defined(__COMPACT__) || defined(__LARGE__) || defined(__HUGE__)
